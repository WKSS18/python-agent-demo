# 复制为 .env.production。所有示例密码和密钥都必须替换。
APP_NAME=Fieldnote AI Agent
APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 同源部署留空；分域时填写前端 Origin，多个值用英文逗号分隔，禁止填 *。
CORS_ALLOWED_ORIGINS=

MYSQL_DATABASE=ai_agent_demo
MYSQL_USER=ai_agent_app
MYSQL_PASSWORD=replace-with-strong-app-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DATABASE_URL=mysql+pymysql://ai_agent_app:replace-with-strong-app-password@mysql:3306/ai_agent_demo?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

WEB_CONCURRENCY=2
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=
ANTHROPIC_VISION_ENABLED=true
API_TIMEOUT_MS=600000

VECTOR_STORE_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-long-random-qdrant-api-key
QDRANT_COLLECTION=note_chunks
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=/opt/fastembed-cache
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_MODEL_PATH=/opt/fastembed-cache/fast-bge-small-zh-v1.5
VECTOR_REQUEST_TIMEOUT_SECONDS=10
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=12
RAG_VECTOR_SCORE_THRESHOLD=0.55
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_OBJECT_PREFIX=ai-agent-demo
OSS_SIGNED_URL_EXPIRE_SECONDS=3600
ATTACHMENT_STORAGE_BACKEND=auto
LOCAL_UPLOAD_DIR=/data/uploads
LOCAL_UPLOAD_URL_PREFIX=/api/uploads/local
RABBITMQ_DEFAULT_USER=fieldnote
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password
RABBITMQ_URL=amqp://fieldnote:replace-with-a-long-random-password@rabbitmq:5672/%2F
RABBITMQ_DOCUMENT_QUEUE=fieldnote.document.import
RABBITMQ_DOCUMENT_DLX=fieldnote.document.dlx
DOCUMENT_MAX_ATTEMPTS=3
MCP_SERVER_URL=http://mcp-tools:8010/mcp
MCP_TIMEOUT_SECONDS=12
