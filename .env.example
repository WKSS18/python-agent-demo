# 本地开发配置。复制为 .env 后按需修改，禁止提交真实密钥。
APP_NAME=Fieldnote AI Agent
APP_ENV=local
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ALLOWED_ORIGINS=

# 本地零依赖启动默认使用 SQLite；准生产部署使用 .env.production.example。
DATABASE_URL=sqlite:///./ai_agent_demo.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=
ANTHROPIC_VISION_ENABLED=true
API_TIMEOUT_MS=600000

VECTOR_STORE_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=note_chunks
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
VECTOR_REQUEST_TIMEOUT_SECONDS=10
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=12
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_OBJECT_PREFIX=ai-agent-demo
OSS_SIGNED_URL_EXPIRE_SECONDS=3600
