# 本地开发配置。复制为 .env 后按需修改，禁止提交真实密钥。
APP_NAME=Fieldnote AI Agent
APP_ENV=local
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ALLOWED_ORIGINS=

# 本地零依赖启动默认使用 SQLite；准生产部署使用 .env.production.example。
DATABASE_URL=sqlite:///./ai_agent_demo.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=
ANTHROPIC_VISION_ENABLED=true
API_TIMEOUT_MS=600000

VECTOR_STORE_ENABLED=false
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=note_chunks
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_MODEL_PATH=
VECTOR_REQUEST_TIMEOUT_SECONDS=10
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=12
RAG_VECTOR_SCORE_THRESHOLD=0.55
RAG_RERANKER=hybrid
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_MODEL_PATH=
RAG_RERANKER_TOP_N=5
RAG_MIN_CONFIDENCE=0.42
RAG_MIN_TOP_SCORE=0.45
RAG_MIN_SCORE_MARGIN=0.02
RAG_MIN_LEXICAL_SCORE=0.12
RAG_SEMANTIC_ONLY_SCORE_THRESHOLD=0.72
RAG_CITATION_CONFIDENCE_THRESHOLD=0.85
RAG_CITATION_RELEVANCE_SATURATION=0.60
RAG_CITATION_MARGIN_SATURATION=0.15
RAG_SOURCE_TRUST_DEFAULT=0.80
RAG_SOURCE_TRUST_CURATED=0.95
RAG_HOOKS=normalize_query,deduplicate,confidence_guard
RAG_FINE_TUNED_MODEL_ENABLED=false
RAG_FINE_TUNED_MODEL=
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_OBJECT_PREFIX=ai-agent-demo
OSS_SIGNED_URL_EXPIRE_SECONDS=3600
ATTACHMENT_STORAGE_BACKEND=auto
LOCAL_UPLOAD_DIR=/data/uploads
LOCAL_UPLOAD_URL_PREFIX=/api/uploads/local
RABBITMQ_DEFAULT_USER=fieldnote
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password
RABBITMQ_URL=amqp://fieldnote:replace-with-a-long-random-password@rabbitmq:5672/%2F
RABBITMQ_DOCUMENT_QUEUE=fieldnote.document.import
RABBITMQ_DOCUMENT_DLX=fieldnote.document.dlx
DOCUMENT_MAX_ATTEMPTS=3
MCP_SERVER_URL=http://mcp-tools:8010/mcp
MCP_TIMEOUT_SECONDS=12
WEATHER_DEFAULT_CITY=上海
